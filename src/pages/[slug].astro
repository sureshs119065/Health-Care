---
import Shop from "../layouts/Shop.astro";
import { STORE_NAME, WHATSAPP_NUMBER } from "../config";
import { INFO_PAGES, type InfoPage } from "../lib/policies";

export function getStaticPaths() {
  return INFO_PAGES.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props as { page: InfoPage };
const wa = `https://wa.me/${WHATSAPP_NUMBER.replace(/\D/g, "")}`;
---
<Shop title={`${page.title} | ${STORE_NAME}`} description={page.intro}>
  <div class="container-x max-w-4xl py-8 md:py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href="/" class="underline-offset-2 hover:underline">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">{page.title}</span>
    </nav>
    <h1 class="mt-3 text-3xl font-bold md:text-4xl">{page.title}</h1>
    <p class="mt-3 max-w-prose text-lg text-muted">{page.intro}</p>
    <div class="mt-8 space-y-8">
      {page.sections.map((s) => (
        <section>
          {s.heading && <h2 class="mb-2 text-xl font-bold">{s.heading}</h2>}
          {s.paras?.map((t) => <p class="mt-2 max-w-prose text-lg">{t}</p>)}
          {s.list && (
            <ul class="mt-2 max-w-prose list-disc space-y-2 pl-5 text-lg marker:text-leaf">
              {s.list.map((t) => <li>{t}</li>)}
            </ul>
          )}
        </section>
      ))}
    </div>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/shop" class="btn btn-primary">Shop products</a>
      <a href={wa} target="_blank" rel="noopener" class="btn btn-whatsapp">Ask on WhatsApp</a>
    </div>
  </div>
</Shop>

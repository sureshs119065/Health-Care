---
import Shop from "../layouts/Shop.astro";
import CheckoutForm from "../components/CheckoutForm.astro";
import { STORE_NAME } from "../config";
---
<Shop title={`Your cart | ${STORE_NAME}`} description="Review your cart and send your order on WhatsApp." drawer={false} bar={false} noindex>
  <div class="container-x py-8 md:py-10">
    <h1 class="text-3xl font-bold">Your cart</h1>

    <p id="notice" class="mt-4 hidden rounded-xl border-2 border-saffron bg-amber-50 p-3 font-semibold" role="status"></p>

    <div id="skeleton" class="mt-6 grid gap-8 lg:grid-cols-[1fr_440px]" aria-hidden="true">
      <div class="skeleton h-64"></div>
      <div class="skeleton h-96"></div>
    </div>

    <div id="error" class="mt-6 hidden rounded-2xl border-2 border-red-800 bg-white p-6 text-center" role="alert">
      <p class="text-lg font-semibold">We could not load the menu, so we cannot show your cart.</p>
      <button id="retry" type="button" class="btn btn-primary mt-4">Retry</button>
    </div>

    <div id="empty" class="mt-6 hidden rounded-2xl bg-cream-dark p-8 text-center">
      <p class="text-lg font-semibold">Your cart is empty.</p>
      <a href="/shop" class="btn btn-primary mt-4">Browse products</a>
    </div>

    <div id="content" class="mt-6 hidden gap-8 lg:grid-cols-[1fr_440px] lg:items-start">
      <section aria-labelledby="items-title" class="rounded-2xl border border-line bg-white p-5">
        <h2 id="items-title" class="text-xl font-bold">Items</h2>
        <ul id="cart-list" class="divide-y divide-line"></ul>
        <p id="cart-warning" class="mt-3 hidden font-semibold text-red-800"></p>
        <p class="mt-4 flex justify-between border-t border-line pt-4 text-xl font-bold">
          <span>Subtotal</span><span id="cart-total">₹0</span>
        </p>
        <p class="mt-2 flex justify-between text-sm text-muted"><span>Delivery</span><span>Confirmed on WhatsApp</span></p>
        <p class="mt-1 text-sm text-muted">We confirm the final total on WhatsApp before you pay.</p>
        <a href="/shop" class="btn btn-outline mt-4">Add more items</a>
      </section>

      <section aria-labelledby="checkout-title" class="rounded-2xl border border-line bg-white p-5 lg:sticky lg:top-20">
        <div id="checkout-wrap">
          <h2 id="checkout-title" class="mb-4 text-xl font-bold">Your details</h2>
          <CheckoutForm prefix="p" />
        </div>
        <div id="sent" class="hidden space-y-4">
          <h2 class="text-xl font-bold">Almost done</h2>
          <p class="text-lg font-semibold">WhatsApp should have opened with your order.</p>
          <p>Press send inside WhatsApp. Then come back here and tap “I sent the order”.</p>
          <button id="sent-done" type="button" class="btn btn-primary w-full">I sent the order</button>
          <a id="reopen" href="#" target="_blank" rel="noopener" class="btn btn-outline w-full">Open WhatsApp again</a>
          <button id="sent-back" type="button" class="btn btn-outline w-full">Back to edit my order</button>
        </div>
      </section>
    </div>
  </div>

  <script>
    import "../scripts/cart-page";
  </script>
</Shop>

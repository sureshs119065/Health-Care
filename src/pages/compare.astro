---
import Shop from "../layouts/Shop.astro";
import { STORE_NAME } from "../config";
---
<Shop title={`Compare products | ${STORE_NAME}`} description="Compare price, pack size and nutrition side by side." tray={false} noindex>
  <div class="mx-auto max-w-[1400px] px-4 py-6">
    <h1 class="text-3xl font-bold">Compare products</h1>
    <p class="mt-1 max-w-2xl">Price, pack size and nutrition side by side. Nutrition values are per 100 g, as supplied by the seller.</p>

    <p id="notice" class="mt-4 hidden rounded-lg border-2 border-saffron bg-amber-50 p-3 font-semibold" role="status"></p>

    <div id="skeleton" class="skeleton mt-6 h-72" aria-hidden="true"></div>

    <div id="error" class="mt-6 hidden rounded-xl border-2 border-red-800 bg-white p-6 text-center" role="alert">
      <p class="text-lg font-semibold">We could not load the menu.</p>
      <button id="retry" type="button" class="btn btn-primary mt-4">Retry</button>
    </div>

    <div id="empty" class="mt-6 hidden rounded-xl bg-cream-dark p-8 text-center">
      <p class="text-lg font-semibold">Nothing to compare yet.</p>
      <p class="mt-1">Tick “Compare” on up to three products in the shop.</p>
      <a href="/shop" class="btn btn-primary mt-4">Go to the shop</a>
    </div>

    <div id="wrap" class="mt-6 hidden">
      <div class="overflow-x-auto rounded-xl border border-line bg-white" tabindex="0" role="region" aria-label="Product comparison table">
        <table id="compare-table" class="w-full min-w-[640px] border-collapse text-left"></table>
      </div>
      <a href="/shop" class="btn btn-outline mt-4">Back to the shop</a>
    </div>
  </div>

  <script>
    import "../scripts/compare-page";
  </script>
</Shop>

---
import Shop from "../layouts/Shop.astro";
import Contact from "../components/Contact.astro";
import Icon from "../components/Icon.astro";
import PromoBanner from "../components/PromoBanner.astro";
import DiwaliScene from "../components/DiwaliScene.astro";
import { artSvg } from "../lib/art";
import type { IconName } from "../lib/icons";
import {
  ABOUT_STORY, BUNDLES, CAMPAIGNS, FSSAI_NUMBER, HERO_IMAGE, HYGIENE_NOTE, NEEDS, OFFERS, PACKAGING_NOTE,
  SELLER_NAME, DIWALI, SITE_URL, STORE_NAME, TRUST_POINTS, WHATSAPP_NUMBER, BESTSELLER_TAG,
} from "../config";
import { wording } from "../lib/copy";

const strip: [IconName, string, string][] = [
  ["whatsapp", "Order on WhatsApp", "One message, no account"],
  ["shield", "Pay after we confirm", "UPI QR only after your total is confirmed"],
  ["list", "Ingredients on every pack", "Nutrition per 100 g listed"],
  ["scale", "Compare by price per 100 g", "See what you really pay"],
];
const trustIcons: IconName[] = ["heart", "list", "shield", "check"];
const steps = [
  ["Browse the shop", "Every pack shows its price, size and price per 100 g."],
  ["Add to cart", "Choose the quantity for each item."],
  ["Enter your details", "Name, phone number, address and any notes."],
  ["Send on WhatsApp", "Your order opens in WhatsApp, ready to send."],
  ["We confirm, you pay", "We confirm your total and share a UPI QR. You pay only then."],
];
const story = ABOUT_STORY || `${STORE_NAME} is run by a nurse who makes these foods in small batches and sells them directly to customers.`;
const heroTiles: [string, string, string][] = [
  ["Soup Mixes", "-6deg", "0ms"], ["Breakfast", "4deg", "90ms"], ["Snacks", "3deg", "180ms"], ["Sweets", "-4deg", "270ms"],
];
const offer = OFFERS[0];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: STORE_NAME,
  url: SITE_URL,
  logo: `${SITE_URL}/icon-512.png`,
  contactPoint: { "@type": "ContactPoint", contactType: "customer service", telephone: `+${WHATSAPP_NUMBER.replace(/\D/g, "")}`, availableLanguage: ["en"] },
};
const skeletonCards = Array.from({ length: 4 });
void BESTSELLER_TAG;
---
<Shop title={`${STORE_NAME} | ${wording.title}`} description={wording.metaDescription} jsonLd={jsonLd}>
  <!-- 2. Hero -->
  <section class="relative isolate overflow-hidden bg-leaf-dark text-white" aria-labelledby="hero-title">
    <div class="pointer-events-none absolute -right-24 -top-24 -z-0 h-96 w-96 rounded-full bg-leaf-soft/40 blur-3xl" aria-hidden="true"></div>
    <div class="container-x relative grid gap-8 py-10 md:py-16 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-12">
      <div>
        <p class="badge bg-accent text-ink">Made by a nurse, ordered on WhatsApp</p>
        <h1 id="hero-title" class="mt-4 max-w-2xl text-4xl md:text-6xl">{wording.title}</h1>
        <p class="mt-4 max-w-xl text-lg text-white/90 md:text-xl">{wording.valueProp}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/shop" class="btn btn-accent btn-lg">Shop all products</a>
          <a href="/recipes" class="btn btn-ghost-light btn-lg">Watch recipe videos</a>
        </div>
      </div>
      {HERO_IMAGE ? (
        <img src={HERO_IMAGE} alt="Our products" width="800" height="640" fetchpriority="high" class="w-full rounded-[2rem] object-cover shadow-[var(--shadow-pop)]" />
      ) : (
        <div class="grid grid-cols-2 gap-3 md:gap-4 lg:pl-6" aria-hidden="true">
          {heroTiles.map(([cat, rot, delay], i) => (
            <div class={`rise overflow-hidden rounded-[1.75rem] shadow-[var(--shadow-pop)] ${i % 2 ? "translate-y-5" : ""}`} style={`--r:${rot};--d:${delay}`} set:html={artSvg(cat, i).replace("<svg ", '<svg width="100%" height="100%" ')}></div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Ordering facts strip -->
  <section class="container-x relative z-10 -mt-6 md:-mt-8" aria-label="How shopping here works">
    <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line shadow-[var(--shadow-card)] lg:grid-cols-4">
      {strip.map(([icon, t, d]) => (
        <li class="flex items-start gap-3 bg-surface p-4">
          <span class="mt-0.5 text-leaf"><Icon name={icon} size={26} /></span>
          <span><span class="block font-bold leading-snug">{t}</span><span class="text-sm text-muted">{d}</span></span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Diwali special -->
  {DIWALI.enabled && (
    <section id="diwali" class="diwali-sky relative isolate mt-8 overflow-hidden scroll-mt-32" aria-labelledby="diwali-title">
      <div class="stars" aria-hidden="true"></div>
      <DiwaliScene diyas />
      <div class="container-x relative z-[2] pb-20 pt-24 md:pb-24 md:pt-28">
        <div class="mx-auto max-w-3xl text-center">
          <p class="badge bg-accent text-ink">Diwali special</p>
          <h2 id="diwali-title" class="diwali-title mt-3 text-4xl font-extrabold md:text-6xl">{DIWALI.title}</h2>
          <p class="mx-auto mt-3 max-w-xl text-lg text-white/90">{DIWALI.text}</p>
        </div>
        <div id="diwali-offer" class="mx-auto mt-8 max-w-4xl" aria-live="polite">
          <div class="skeleton h-72 bg-white/10" aria-hidden="true"></div>
        </div>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/offers" class="btn btn-ghost-light btn-lg">All Diwali offers</a>
          <button type="button" data-light-cracker class="btn btn-accent btn-lg">Light a cracker</button>
        </div>
      </div>
    </section>
  )}

  <div class="container-x">
    <p id="notice" class="mt-6 hidden rounded-xl border-2 border-saffron bg-amber-50 p-3 font-semibold" role="status"></p>
    <div id="home-error" class="mt-6 hidden rounded-2xl border-2 border-red-800 bg-surface p-6 text-center" role="alert">
      <p class="text-lg font-semibold">We could not load the products.</p>
      <p class="mt-1">Check your internet connection and try again.</p>
      <button id="retry" type="button" class="btn btn-primary mt-4">Retry</button>
    </div>
  </div>

  <!-- 3. Category shortcuts -->
  <section class="container-x section" aria-labelledby="cat-title">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <div>
        <h2 id="cat-title" class="section-title">Shop by category</h2>
        <p class="section-sub">Everything we make, grouped the way you cook.</p>
      </div>
      <a href="/shop" class="link-more">All products</a>
    </div>
    <ul id="cat-tiles" class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4 lg:[grid-template-columns:repeat(auto-fit,minmax(11rem,1fr))]">
      {skeletonCards.map(() => <li class="skeleton aspect-[4/5]" aria-hidden="true"></li>)}
    </ul>
  </section>

  <!-- 4. Promotional collections -->
  <section class="container-x pb-4" aria-labelledby="promo-title">
    <h2 id="promo-title" class="sr-only">Featured collections</h2>
    <div class="grid gap-4 lg:grid-cols-2 lg:grid-rows-2">
      <div class="lg:row-span-2 [&>article]:h-full">
        {offer
          ? <PromoBanner title={offer.title} text={offer.text} cta={offer.cta} href={offer.href} tone="berry" badge="Offer" size="lg" art="Sweets" />
          : <PromoBanner {...CAMPAIGNS[0]} size="lg" />}
      </div>
      {CAMPAIGNS.slice(1, 3).map((c) => <PromoBanner {...c} />)}
    </div>
  </section>

  <!-- 5. Bestsellers -->
  <section class="container-x section" aria-labelledby="best-title">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 id="best-title" class="section-title">Bestsellers</h2>
        <p class="section-sub">The seller’s favourites. Prices include pack size and price per 100 g.</p>
      </div>
      <div class="flex items-center gap-2">
        <div id="best-arrows" class="flex gap-2"></div>
        <a href="/shop?bestsellers=1" class="link-more">See all</a>
      </div>
    </div>
    <ul id="best-track" class="snap-row mt-5 -mx-4 px-4 md:mx-0 md:px-0" tabindex="0" aria-label="Bestselling products, scroll sideways for more">
      {skeletonCards.map(() => <li class="skeleton aspect-[3/4] w-[46vw] max-w-[260px] shrink-0 md:w-60" aria-hidden="true"></li>)}
    </ul>
  </section>

  <!-- 6. Shop by need -->
  <section class="bg-cream-dark" aria-labelledby="need-title">
    <div class="container-x section">
      <h2 id="need-title" class="section-title">Shop by need</h2>
      <p class="section-sub">Start from what you need today.</p>
      <ul class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {NEEDS.map((n, i) => (
          <li>
            <a href={n.href} class="card group flex h-full flex-col gap-2 p-4 transition hover:-translate-y-0.5 hover:border-leaf hover:shadow-[var(--shadow-lift)]">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-tint text-leaf"><Icon name={(["package", "clock", "scale", "leaf", "tag"] as IconName[])[i % 5]} size={22} /></span>
              <span class="text-lg font-bold leading-snug">{n.title}</span>
              <span class="text-sm text-muted">{n.text}</span>
              <span class="mt-auto pt-1 font-semibold text-leaf group-hover:underline">Shop now</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 7. Reels -->
  <section class="bg-leaf-dark text-white" aria-labelledby="reel-title">
    <div class="container-x section">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 id="reel-title" class="section-title">Watch, discover and enjoy</h2>
          <p id="reel-sub" class="mt-1 max-w-2xl text-white/85">Short videos of our products and how to use them. Tap a video to play it.</p>
        </div>
        <div id="reel-arrows" class="flex gap-2"></div>
      </div>
      <ul id="reel-track" class="snap-row mt-5 -mx-4 px-4 md:mx-0 md:px-0" tabindex="0" aria-label="Product videos, scroll sideways for more">
        {skeletonCards.map(() => <li class="aspect-[9/16] w-[62vw] max-w-[260px] shrink-0 animate-pulse rounded-[1.25rem] bg-white/10 sm:w-56" aria-hidden="true"></li>)}
      </ul>
    </div>
  </section>

  <!-- 8. Trust -->
  <section class="container-x section" aria-labelledby="trust-title">
    <h2 id="trust-title" class="section-title">Why customers can trust us</h2>
    <p class="section-sub">Plain facts you can check on every product page.</p>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {TRUST_POINTS.map((t, i) => (
        <li class="card p-5">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-tint text-leaf"><Icon name={trustIcons[i % 4]} size={22} /></span>
          <p class="mt-3 font-display text-lg font-bold">{t.title}</p>
          <p class="mt-1 text-muted">{t.text}</p>
        </li>
      ))}
    </ul>
    {(HYGIENE_NOTE || PACKAGING_NOTE) && (
      <div class="mt-4 grid gap-3 md:grid-cols-2">
        {HYGIENE_NOTE && <p class="rounded-2xl bg-tint p-4"><strong>Hygiene. </strong>{HYGIENE_NOTE}</p>}
        {PACKAGING_NOTE && <p class="rounded-2xl bg-tint p-4"><strong>Packaging. </strong>{PACKAGING_NOTE}</p>}
      </div>
    )}
    <p class="mt-4 text-sm text-muted">FSSAI Lic. No. {FSSAI_NUMBER}. <a href="/quality" class="font-semibold text-leaf underline underline-offset-4">What we check and what we do not claim</a></p>
  </section>

  <!-- 9. Recipe and usage inspiration -->
  <section class="bg-tint" aria-labelledby="use-title">
    <div class="container-x section">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <div>
          <h2 id="use-title" class="section-title">How to use our products</h2>
          <p class="section-sub">Simple ways to turn a pack into a meal.</p>
        </div>
        <a href="/recipes" class="link-more">All recipe videos</a>
      </div>
      <ul id="use-grid" class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {skeletonCards.map(() => <li class="skeleton h-56" aria-hidden="true"></li>)}
      </ul>
    </div>
  </section>

  <!-- 10. Value sets -->
  {BUNDLES.length > 0 && (
    <section id="sets" class="container-x section scroll-mt-32" aria-labelledby="sets-title">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <div>
          <h2 id="sets-title" class="section-title">Ready-made sets</h2>
          <p class="section-sub">Add a few products in one tap. Same prices as buying each item separately.</p>
        </div>
        <a href="/offers#sets" class="link-more">All sets</a>
      </div>
      <ul id="bundle-list" class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {skeletonCards.slice(0, 3).map(() => <li class="skeleton h-72" aria-hidden="true"></li>)}
      </ul>
    </section>
  )}

  <!-- 11. Brand story -->
  <section class="bg-cream-dark" aria-labelledby="story-title">
    <div class="container-x section grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <h2 id="story-title" class="section-title">Meet the nurse behind the food</h2>
        <p class="mt-3 max-w-2xl text-lg">{SELLER_NAME ? `${SELLER_NAME}. ` : ""}{story}</p>
        <p class="mt-2 text-muted">FSSAI Lic. No. {FSSAI_NUMBER}</p>
      </div>
      <a href="/about" class="btn btn-primary btn-lg">Read our story</a>
    </div>
  </section>

  <!-- How ordering works -->
  <section class="container-x section" aria-labelledby="how-title">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <h2 id="how-title" class="section-title">How ordering works</h2>
      <a href="/how-to-order" class="link-more">Full ordering guide</a>
    </div>
    <ol class="mt-5 grid gap-3 md:grid-cols-5">
      {steps.map(([t, d], i) => (
        <li class="card p-4">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent text-sm font-bold text-ink">{i + 1}</span>
          <p class="mt-2 font-display text-lg font-bold">{t}</p>
          <p class="mt-1 text-muted">{d}</p>
        </li>
      ))}
    </ol>
  </section>

  <Contact />

  <script>
    import "../scripts/home";
  </script>
</Shop>

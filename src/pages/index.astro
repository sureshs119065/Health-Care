---
import Shop from "../layouts/Shop.astro";
import Faq from "../components/Faq.astro";
import Contact from "../components/Contact.astro";
import { SITE_URL, STORE_NAME, WHATSAPP_NUMBER } from "../config";
import { wording } from "../lib/copy";

const steps = [
  ["Browse the menu", "Search or pick a category to find what you like."],
  ["Add to cart", "Choose the quantity for each item."],
  ["Enter your details", "Name, phone number, address and any notes."],
  ["Send on WhatsApp", "Your order opens in WhatsApp, ready to send."],
  ["Confirm and pay", "We confirm your total and send a UPI QR. You pay only then."],
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: STORE_NAME,
  url: SITE_URL,
  logo: `${SITE_URL}/icon-512.png`,
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    telephone: `+${WHATSAPP_NUMBER.replace(/\D/g, "")}`,
    availableLanguage: ["en"],
  },
};
---
<Shop title={`${STORE_NAME} | ${wording.title}`} description={wording.metaDescription} jsonLd={jsonLd}>
  <section class="bg-leaf text-cream">
    <div class="mx-auto max-w-[1400px] px-4 py-10 md:py-16">
      <h1 class="max-w-3xl text-3xl font-bold md:text-5xl">{wording.title}</h1>
      <p class="mt-4 max-w-2xl text-lg">
        Pick your items, then send your order on WhatsApp. No online payment. We confirm your total and share a UPI QR.
      </p>
      <a href="#menu" class="btn mt-6 bg-cream text-leaf-dark hover:bg-cream-dark">See the menu</a>
    </div>
  </section>

  <section id="menu" class="mx-auto max-w-[1400px] scroll-mt-16 px-4 py-8 lg:grid lg:grid-cols-[250px_1fr] lg:gap-8">
    <aside class="lg:sticky lg:top-20 lg:self-start" aria-label="Search and filters">
      <label for="search" class="mb-1 block font-semibold">Search the menu</label>
      <input id="search" type="search" class="input" placeholder="Try “millet” or “snack”" autocomplete="off" />
      <p class="mb-1 mt-4 font-semibold" id="cat-label">Categories</p>
      <div id="chips" class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-2 lg:mx-0 lg:flex-col lg:overflow-visible lg:px-0" role="group" aria-labelledby="cat-label"></div>
    </aside>

    <div class="mt-4 min-h-[60vh] lg:mt-0">
      <p id="notice" class="mb-4 hidden rounded-lg border-2 border-saffron bg-amber-50 p-3 font-semibold" role="status"></p>

      <div id="skeleton" class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4 xl:grid-cols-4" aria-hidden="true">
        {Array.from({ length: 8 }).map(() => <div class="skeleton aspect-[3/4]"></div>)}
      </div>

      <div id="error" class="hidden rounded-xl border-2 border-red-800 bg-white p-6 text-center" role="alert">
        <p class="text-lg font-semibold">We could not load the menu.</p>
        <p class="mt-1">Check your internet connection and try again.</p>
        <button id="retry" type="button" class="btn btn-primary mt-4">Retry</button>
      </div>

      <p id="empty" class="hidden rounded-xl bg-cream-dark p-6 text-center font-semibold">
        No items match your search. Try another word or choose “All”.
      </p>

      <ul id="grid" class="hidden grid-cols-2 gap-3 md:grid-cols-3 md:gap-4 xl:grid-cols-4"></ul>
    </div>
  </section>

  <section class="bg-cream-dark" aria-labelledby="how-title">
    <div class="mx-auto max-w-[1400px] px-4 py-10">
      <h2 id="how-title" class="text-2xl font-bold md:text-3xl">How ordering works</h2>
      <ol class="mt-6 grid gap-4 md:grid-cols-5">
        {steps.map(([t, d], i) => (
          <li class="rounded-xl border border-line bg-cream p-4">
            <p class="font-serif text-lg font-bold text-leaf">{i + 1}. {t}</p>
            <p class="mt-1">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Faq />
  <Contact />

  <script>
    import "../scripts/home";
  </script>
</Shop>

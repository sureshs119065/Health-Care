---
import Shop from "../layouts/Shop.astro";
import { STORE_NAME, WHATSAPP_NUMBER } from "../config";
const href = `https://wa.me/${WHATSAPP_NUMBER.replace(/\D/g, "")}`;
---
<Shop title={`Page not found | ${STORE_NAME}`} description="This page could not be found." drawer={false} bar={false} noindex>
  <div class="mx-auto max-w-xl px-4 py-16 text-center">
    <h1 class="text-3xl font-bold">We could not find that page</h1>
    <p class="mt-3 text-lg">The link may be old or mistyped. You can go back to the menu or message us on WhatsApp.</p>
    <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/" class="btn btn-primary">Go to the menu</a>
      <a href={href} target="_blank" rel="noopener" class="btn btn-outline">Chat on WhatsApp</a>
    </div>
  </div>
</Shop>

---
import "../styles/global.css";
import { ENABLE_PWA, SITE_URL, STORE_NAME } from "../config";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}
const { title, description, image = "/og-image.png", noindex = false, jsonLd } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = new URL(path, SITE_URL).href;
const ogImage = new URL(image, SITE_URL).href;
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : "";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1f5d3a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    {ENABLE_PWA && <link rel="manifest" href="/manifest.webmanifest" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={STORE_NAME} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${STORE_NAME}: order healthy foods on WhatsApp`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {ld && <script type="application/ld+json" set:html={ld} />}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-[60] focus:rounded-lg focus:bg-surface focus:px-4 focus:py-3 focus:font-semibold"
    >Skip to content</a>
    <slot />
    <div id="live" class="sr-only" aria-live="polite" role="status"></div>
  </body>
</html>

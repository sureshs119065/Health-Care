---
import CheckoutForm from "./CheckoutForm.astro";
---
<div id="drawer" class="pointer-events-none fixed inset-0 z-50" inert>
  <div id="overlay" class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300"></div>
  <div
    id="panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="drawer-title"
    class="absolute right-0 top-0 flex h-full w-full max-w-md translate-x-full flex-col bg-white shadow-xl transition-transform duration-300"
  >
    <div class="flex items-center justify-between border-b border-line p-4">
      <h2 id="drawer-title" class="text-xl font-bold">Your cart</h2>
      <button id="close" type="button" class="btn btn-outline" aria-label="Close cart">Close</button>
    </div>

    <section id="view-cart" class="flex min-h-0 flex-1 flex-col">
      <ul id="cart-list" class="flex-1 divide-y divide-line overflow-y-auto px-4"></ul>
      <p id="cart-empty" class="hidden flex-1 p-6 text-center">Your cart is empty. Add something from the shop.</p>
      <div class="space-y-3 border-t border-line p-4">
        <p id="cart-warning" class="hidden font-semibold text-red-800"></p>
        <p class="flex justify-between text-lg font-bold"><span>Subtotal</span><span id="cart-total">₹0</span></p>
        <p class="flex justify-between text-sm text-muted"><span>Delivery</span><span>Confirmed on WhatsApp</span></p>
        <p class="text-sm text-muted">We confirm the final total on WhatsApp before you pay.</p>
        <button id="to-checkout" type="button" class="btn btn-accent btn-lg w-full">Checkout</button>
      </div>
    </section>

    <section id="view-checkout" class="hidden min-h-0 flex-1 overflow-y-auto p-4" hidden>
      <CheckoutForm prefix="d" showBack />
    </section>

    <section id="view-sent" class="hidden min-h-0 flex-1 space-y-4 overflow-y-auto p-4" hidden>
      <p class="text-lg font-semibold">WhatsApp should have opened with your order.</p>
      <p>Press send inside WhatsApp. Then come back here and tap “I sent the order”.</p>
      <button id="sent-done" type="button" class="btn btn-primary w-full">I sent the order</button>
      <a id="reopen" href="#" target="_blank" rel="noopener" class="btn btn-outline w-full">Open WhatsApp again</a>
      <button id="sent-back" type="button" class="btn btn-outline w-full">Back to cart</button>
    </section>
  </div>
</div>

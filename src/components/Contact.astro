---
import { WHATSAPP_NUMBER, SERVICE_AREA, ORDER_HOURS } from "../config";
const digits = WHATSAPP_NUMBER.replace(/\D/g, "");
const href = `https://wa.me/${digits}?text=${encodeURIComponent("Hello, I have a question about your products.")}`;
---
<section id="contact" class="scroll-mt-32 bg-leaf-dark text-white" aria-labelledby="contact-title">
  <div class="container-x flex flex-col items-center py-12 text-center md:py-16">
    <h2 id="contact-title" class="text-2xl font-bold md:text-3xl">Talk to us</h2>
    <p class="mx-auto mt-2 max-w-xl text-lg">Questions about ingredients, delivery or a bulk order? Message us on WhatsApp.</p>
    <ul class="mt-4 space-y-1 text-white/90">
      <li>WhatsApp: +{digits}</li>
      <li>{ORDER_HOURS}</li>
      <li>{SERVICE_AREA}</li>
    </ul>
    <a href={href} target="_blank" rel="noopener" class="btn btn-accent btn-lg mt-6">Chat on WhatsApp</a>
  </div>
</section>

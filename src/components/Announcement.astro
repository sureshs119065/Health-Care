---
import { ANNOUNCEMENTS } from "../config";
---
{ANNOUNCEMENTS.length > 0 && (
  <div id="announce" class="bg-leaf-dark text-white" role="region" aria-label="Announcements">
    <div class="container-x flex min-h-10 items-center justify-center gap-3 py-1 text-center text-sm font-medium">
      <p id="announce-text" class="min-w-0" data-items={JSON.stringify(ANNOUNCEMENTS)}>
        {ANNOUNCEMENTS[0].href
          ? <a href={ANNOUNCEMENTS[0].href} class="underline underline-offset-4 hover:text-accent">{ANNOUNCEMENTS[0].text}</a>
          : ANNOUNCEMENTS[0].text}
      </p>
      <button id="announce-close" type="button" class="-mr-2 hidden h-11 w-11 shrink-0 items-center justify-center rounded-full hover:bg-white/10 sm:inline-flex" aria-label="Dismiss announcement">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
  </div>
)}
